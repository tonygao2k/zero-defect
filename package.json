{
  "name": "zero-defect",
  "productName": "超级错题本",
  "version": "1.0.0",
  "private": true,
  "description": "小学生错题针对性训练系统(Zero Defect)",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "TonyGao",
    "email": "tonygao2k@hotmail.com"
  },
  "scripts": {
    "start": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build:web": "tsc --noEmit && vite build",
    "build": "tauri build",
    "postbuild": "node scripts/collect-bundles.mjs",
    "package": "tauri build --no-bundle",
    "make": "npm run build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.92.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "@tauri-apps/cli": "^2"
  },
  "dependencies": {
    "fraction.js": "^5.3.4",
    "katex": "^0.19.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.6.7",
    "@tauri-apps/api": "^2"
  }
}
